{
  "name": "antigravity-light",
  "version": "1.0.0",
  "description": "Lightweight, cross-platform Antigravity account manager, quota auto-switcher, and local OpenAI proxy",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "antigravity-light": "./bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js start",
    "start:detached": "nohup node src/index.js start > ~/.antigravity-light/app.log 2>&1 &",
    "ui:detached": "nohup node src/index.js ui > ~/.antigravity-light/app.log 2>&1 &",
    "stop": "pkill -f 'node.*src/index.js'",
    "cli": "node src/index.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": ["antigravity", "openai-proxy", "gemini", "quota-switcher", "cross-platform"],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
